{
  "expo": {
    "name": "Prime Notes",
    "slug": "primenotes-v2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "primenotes",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#dc2626",
        "foregroundImage": "./assets/images/icon.png"
      },
      "package": "com.rjoulfiand.primenotes",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#dc2626",
          "image": "./assets/images/splash.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-web-browser",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "259c0c82-2619-49f1-bb92-5a59bd27d2a7"
      }
    }
  }
}